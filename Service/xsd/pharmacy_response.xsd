<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:medicare:patient-record"
           xmlns:m="urn:medicare:patient-record"
           elementFormDefault="qualified">
    <xs:simpleType name="StatusType"><xs:restriction base="xs:string"><xs:enumeration value="S"/><xs:enumeration value="F"/><xs:enumeration value="E"/></xs:restriction></xs:simpleType>
    <xs:simpleType name="TimestampType"><xs:restriction base="xs:string"><xs:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}"/></xs:restriction></xs:simpleType>
    <xs:complexType name="ItemType"><xs:sequence><xs:element name="sku" type="xs:string"/><xs:element name="quantity" type="xs:positiveInteger"/><xs:element name="instructions" type="xs:string"/></xs:sequence></xs:complexType>
    <xs:complexType name="CommonType"><xs:sequence><xs:element name="status" type="m:StatusType"/><xs:element name="timestamp" type="m:TimestampType"/><xs:element name="message" type="xs:string"/><xs:element name="requestID" type="xs:string"/></xs:sequence></xs:complexType>
    <xs:element name="errorResponse" type="m:CommonType"/>
    <xs:element name="getPrescriptionResponse">
        <xs:complexType><xs:sequence>
            <xs:element name="status" type="m:StatusType"/><xs:element name="timestamp" type="m:TimestampType"/><xs:element name="message" type="xs:string"/><xs:element name="requestID" type="xs:string"/>
            <xs:element name="prescriptionReference" type="xs:string" minOccurs="0"/><xs:element name="patientExternalId" type="xs:string" minOccurs="0"/><xs:element name="patientName" type="xs:string" minOccurs="0"/><xs:element name="prescriberName" type="xs:string" minOccurs="0"/>
            <xs:element name="items" minOccurs="0"><xs:complexType><xs:sequence><xs:element name="item" type="m:ItemType" minOccurs="1" maxOccurs="unbounded"/></xs:sequence></xs:complexType></xs:element>
        </xs:sequence></xs:complexType>
    </xs:element>
    <xs:element name="getMedicineAvailabilityResponse">
        <xs:complexType><xs:sequence>
            <xs:element name="status" type="m:StatusType"/><xs:element name="timestamp" type="m:TimestampType"/><xs:element name="message" type="xs:string"/><xs:element name="requestID" type="xs:string"/>
            <xs:element name="sku" type="xs:string" minOccurs="0"/><xs:element name="requestedQuantity" type="xs:nonNegativeInteger" minOccurs="0"/><xs:element name="available" type="xs:boolean" minOccurs="0"/><xs:element name="availableQuantity" type="xs:nonNegativeInteger" minOccurs="0"/>
        </xs:sequence></xs:complexType>
    </xs:element>
    <xs:complexType name="MedicineCatalogItemType"><xs:sequence><xs:element name="sku" type="xs:string"/><xs:element name="name" type="xs:string"/><xs:element name="strength" type="xs:string"/><xs:element name="dosageForm" type="xs:string"/><xs:element name="availableQuantity" type="xs:nonNegativeInteger"/></xs:sequence></xs:complexType>
    <xs:element name="getMedicineCatalogResponse"><xs:complexType><xs:sequence>
        <xs:element name="status" type="m:StatusType"/><xs:element name="timestamp" type="m:TimestampType"/><xs:element name="message" type="xs:string"/><xs:element name="requestID" type="xs:string"/>
        <xs:element name="items" minOccurs="0"><xs:complexType><xs:sequence><xs:element name="item" type="m:MedicineCatalogItemType" minOccurs="1" maxOccurs="unbounded"/></xs:sequence></xs:complexType></xs:element>
    </xs:sequence></xs:complexType></xs:element>
    <xs:element name="createApprovedDispensingRequestResponse"><xs:complexType><xs:sequence>
        <xs:element name="status" type="m:StatusType"/><xs:element name="timestamp" type="m:TimestampType"/><xs:element name="message" type="xs:string"/><xs:element name="requestID" type="xs:string"/>
        <xs:element name="dispensingRequestId" type="xs:string" minOccurs="0"/><xs:element name="prescriptionReference" type="xs:string" minOccurs="0"/><xs:element name="dispensingStatus" type="xs:string" minOccurs="0"/>
    </xs:sequence></xs:complexType></xs:element>
</xs:schema>
